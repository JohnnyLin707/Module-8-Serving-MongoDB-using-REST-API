# Copy this file to .env and paste YOUR connection string (Step 4).
# MongoDB Atlas (cloud): replace <username>, <password> and the cluster address with yours.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/bookstore?retryWrites=true&w=majority
# Local MongoDB instead:  MONGODB_URI=mongodb://127.0.0.1:27017/bookstore
PORT=3000
